# Datadog — LLM Observability via Trajectory HTTP export (sem dd-trace)
DD_API_KEY=
DD_SITE=datadoghq.com
DD_ENV=dev
DD_LLMOBS_ML_APP=retail-assistant
DD_LLMOBS_ENABLED=1

# Serviços APM-like (tags Trajectory, não tracer dd-trace)
DD_SERVICE_GATEWAY=retail-gateway
DD_SERVICE_PROCESSOR=retail-processor

# Trajectory
TRAJECTORY_ENABLED=true
TRAJECTORY_EXPORT=true
TRAJECTORY_LOCAL_CAPTURE=true
TRAJECTORY_VERSION=0.1.0
TRAJECTORY_CLIENT_SOURCE=retail-multiagent
TRAJECTORY_CAPTURE_LEVEL=full

# LLM
USE_MOCK_LLM=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Rede
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8001
PROCESSOR_HOST=0.0.0.0
PROCESSOR_PORT=8002
PROCESSOR_URL=http://localhost:8002
