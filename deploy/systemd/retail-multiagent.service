[Unit]
Description=Retail multi-agent (Trajectory LLM Observability)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/llmagent
User=ec2-user
EnvironmentFile=-/opt/llmagent/.env
ExecStart=/opt/llmagent/scripts/compose.sh -f docker-compose.prod.yml up -d --build
ExecStop=/opt/llmagent/scripts/compose.sh -f docker-compose.prod.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
